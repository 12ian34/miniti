require "dotenv"

Dotenv.load(File.expand_path("../.env", __dir__))

opt_out_usage

default_platform(:ios)

PROJECT_PATH = "Miniti.xcodeproj"
IOS_SCHEME = "MinitiMobile"
IOS_CONFIGURATION = "Release"
IOS_OUTPUT_DIRECTORY = "build/ios"
IOS_OUTPUT_NAME = "MinitiMobile.ipa"
IOS_DERIVED_DATA_PATH = "DerivedDataLocal"

def first_env(*keys)
  keys.each do |key|
    value = ENV[key]
    return value unless value.to_s.empty?
  end

  nil
end

def app_store_connect_api_key_from_env
  key_id = first_env(
    "APP_STORE_CONNECT_KEY_ID",
    "APP_STORE_CONNECT_API_KEY_KEY_ID",
    "APPLE_KEY_ID"
  )
  issuer_id = first_env(
    "APP_STORE_CONNECT_ISSUER_ID",
    "APP_STORE_CONNECT_API_KEY_ISSUER_ID",
    "APPLE_ISSUER_ID"
  )
  key_filepath = first_env("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
  key_content = first_env(
    "APP_STORE_CONNECT_API_KEY",
    "APP_STORE_CONNECT_API_KEY_KEY_CONTENT",
    "APPLE_PRIVATE_KEY"
  )

  return nil if key_id.to_s.empty? || issuer_id.to_s.empty?
  return nil if key_filepath.to_s.empty? && key_content.to_s.empty?

  key_content = key_content.gsub('\n', "\n") unless key_content.to_s.empty?

  params = {
    key_id: key_id,
    issuer_id: issuer_id,
    in_house: false
  }

  # Support either a local .p8 file or inline secret content from CI.
  if key_content.to_s.empty?
    params[:key_filepath] = key_filepath
  else
    params[:key_content] = key_content
    params[:is_key_content_base64] = ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true"
  end

  app_store_connect_api_key(**params)
end

platform :ios do
  desc "Build the current iOS release archive locally"
  lane :build do
    build_ios_release
  end

  desc "Bump build/version if needed, build, and upload to TestFlight"
  lane :beta do |options|
    prepare_ios_release(options)
    api_key = load_app_store_connect_api_key
    ipa_path = build_ios_release

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      changelog: options[:changelog],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Bump build/version if needed, build, and upload to App Store Connect without auto-submitting"
  lane :release do |options|
    prepare_ios_release(options)
    api_key = load_app_store_connect_api_key
    ipa_path = build_ios_release

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  private_lane :prepare_ios_release do |options|
    version = options[:version] || options[:version_number]
    build_number = options[:build] || options[:build_number]

    if version
      increment_version_number(
        xcodeproj: PROJECT_PATH,
        version_number: version
      )
    end

    if build_number
      increment_build_number(
        xcodeproj: PROJECT_PATH,
        build_number: build_number
      )
    else
      increment_build_number(xcodeproj: PROJECT_PATH)
    end
  end

  private_lane :build_ios_release do
    build_app(
      project: PROJECT_PATH,
      scheme: IOS_SCHEME,
      configuration: IOS_CONFIGURATION,
      clean: true,
      derived_data_path: IOS_DERIVED_DATA_PATH,
      xcargs: "-allowProvisioningUpdates",
      export_method: "app-store",
      output_directory: IOS_OUTPUT_DIRECTORY,
      output_name: IOS_OUTPUT_NAME
    )
  end

  private_lane :load_app_store_connect_api_key do
    api_key = app_store_connect_api_key_from_env
    UI.user_error!("Missing App Store Connect API key. This repo expects APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID, and APP_STORE_CONNECT_API_KEY in the root .env. Fastlane-style APP_STORE_CONNECT_API_KEY_KEY_ID / APP_STORE_CONNECT_API_KEY_ISSUER_ID / APP_STORE_CONNECT_API_KEY_KEY_FILEPATH or APP_STORE_CONNECT_API_KEY_KEY_CONTENT also work.") if api_key.nil?

    api_key
  end
end
