require "dotenv"
require "fileutils"
require "json"
require "open3"
require "shellwords"

Dotenv.load(File.expand_path("../.env", __dir__))

opt_out_usage

default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)
PROJECT_PATH = File.join(REPO_ROOT, "Miniti.xcodeproj")
IOS_SCHEME = "MinitiMobile"
IOS_CONFIGURATION = "Release"
IOS_OUTPUT_DIRECTORY = File.join(REPO_ROOT, "build", "ios")
IOS_OUTPUT_NAME = "MinitiMobile.ipa"
IOS_DERIVED_DATA_PATH = File.join(REPO_ROOT, "DerivedDataLocal")
MAC_SCHEME = "Miniti"
MAC_CONFIGURATION = "Release"
MAC_OUTPUT_DIRECTORY = File.join(REPO_ROOT, "build", "macos")
MAC_OUTPUT_NAME = "miniti"
MAC_BUNDLE_ID = "com.miniti.app"
MAC_DERIVED_DATA_PATH = File.join(REPO_ROOT, "DerivedDataLocal")
MAC_ARCHIVE_PATH = File.join(MAC_OUTPUT_DIRECTORY, "miniti.xcarchive")
DMG_SCRIPT_PATH = File.join(REPO_ROOT, "scripts", "build-dmg.sh")
MAC_DMG_PATH = File.join(REPO_ROOT, "miniti.dmg")
MAC_ROOT_APP_PATH = File.join(REPO_ROOT, "#{MAC_OUTPUT_NAME}.app")
APPLE_TEAM_ID = "9AUR5U5KTF"

def mac_codesign_identity
  explicit_identity = ENV["MAC_CODESIGN_IDENTITY"]
  return explicit_identity unless explicit_identity.to_s.empty?

  output, status = Open3.capture2e("security", "find-identity", "-v", "-p", "codesigning")
  UI.user_error!("Unable to inspect signing identities in keychain.\n#{output}") unless status.success?

  identities = output.scan(/"((?:Developer ID Application):[^"]+)"/).flatten.uniq
  UI.user_error!("No Developer ID Application identity found in keychain. Create/import one in login keychain, or set MAC_CODESIGN_IDENTITY explicitly.") if identities.empty?

  selected_identity = identities.first
  UI.important("Multiple Developer ID Application identities found. Using '#{selected_identity}'. Set MAC_CODESIGN_IDENTITY to override.") if identities.length > 1
  UI.message("Using macOS codesigning identity: #{selected_identity}")
  selected_identity
end

def first_env(*keys)
  keys.each do |key|
    value = ENV[key]
    return value unless value.to_s.empty?
  end

  nil
end

def read_optional_text_file(path)
  return nil unless File.exist?(path)

  contents = File.read(path).strip
  return nil if contents.empty?

  contents
end

# Scan's default simulator picker compares `xcodebuild -showsdks` versions against `simctl`
# runtime versions with exact string equality (fastlane#29974), so it breaks whenever the SDK is a
# point release ahead of the installed runtime — SDK productVersion 26.5.1 against runtime 26.5
# yields `OS=26.5.1`, which matches no device, and xcodebuild then stalls until scan's
# `-showBuildSettings` retries time out. Resolve a real simulator and pass its UDID instead: that
# reads the version from the runtime that actually exists, and is unambiguous when several
# simulators share a name (there are usually two "iPhone 17 Pro"s, which `name=` can't tell apart).
def ios_unit_test_simulator_name
  name = ENV["MINITI_IOS_TEST_DEVICE_NAME"].to_s.strip
  name.empty? ? "iPhone 17" : name
end

def ios_unit_test_simulator
  devices_json, status = Open3.capture2("xcrun", "simctl", "list", "devices", "available", "--json")
  UI.user_error!("xcrun simctl list devices failed (status #{status.exitstatus}):\n#{devices_json}") unless status.success?

  by_runtime = JSON.parse(devices_json).fetch("devices", {}).select do |runtime, devices|
    runtime.include?("SimRuntime.iOS-") && !devices.empty?
  end

  # Newest runtime first, so a stale older runtime never wins.
  candidates = by_runtime
    .sort_by { |runtime, _| runtime[/iOS-([\d-]+)/, 1].to_s.split("-").map(&:to_i) }
    .reverse
    .flat_map { |_, devices| devices }
    .select { |device| device["isAvailable"] }

  if candidates.empty?
    UI.user_error!("No available iOS simulators. Install an iOS runtime via Xcode > Settings > Components.")
  end

  preferred = ios_unit_test_simulator_name
  match = candidates.find { |device| device["name"] == preferred }
  UI.important("Simulator '#{preferred}' not available — falling back.") if match.nil?
  match ||= candidates.find { |device| device["name"].start_with?("iPhone") } || candidates.first

  UI.message("Using iOS simulator #{match['name']} (#{match['udid']})")
  match
end

def ios_unit_test_destination
  "platform=iOS Simulator,id=#{ios_unit_test_simulator['udid']}"
end

def ios_app_review_information_from_metadata
  notes = read_optional_text_file(File.join(REPO_ROOT, "fastlane", "metadata", "app_review_notes.txt"))
  return nil if notes.nil?

  { notes: notes }
end

def app_store_connect_api_key_from_env
  key_id = first_env(
    "APP_STORE_CONNECT_KEY_ID",
    "APP_STORE_CONNECT_API_KEY_KEY_ID",
    "APPLE_KEY_ID"
  )
  issuer_id = first_env(
    "APP_STORE_CONNECT_ISSUER_ID",
    "APP_STORE_CONNECT_API_KEY_ISSUER_ID",
    "APPLE_ISSUER_ID"
  )
  key_filepath = first_env("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
  key_content = first_env(
    "APP_STORE_CONNECT_API_KEY",
    "APP_STORE_CONNECT_API_KEY_KEY_CONTENT",
    "APPLE_PRIVATE_KEY"
  )

  return nil if key_id.to_s.empty? || issuer_id.to_s.empty?
  return nil if key_filepath.to_s.empty? && key_content.to_s.empty?

  key_content = key_content.gsub('\n', "\n") unless key_content.to_s.empty?

  params = {
    key_id: key_id,
    issuer_id: issuer_id,
    in_house: false
  }

  # Support either a local .p8 file or inline secret content from CI.
  if key_content.to_s.empty?
    params[:key_filepath] = key_filepath
  else
    params[:key_content] = key_content
    params[:is_key_content_base64] = ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true"
  end

  app_store_connect_api_key(**params)
end

private_lane :load_app_store_connect_api_key do
  api_key = app_store_connect_api_key_from_env
  UI.user_error!("Missing App Store Connect API key. This repo expects APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID, and APP_STORE_CONNECT_API_KEY in the root .env. Fastlane-style APP_STORE_CONNECT_API_KEY_KEY_ID / APP_STORE_CONNECT_API_KEY_ISSUER_ID / APP_STORE_CONNECT_API_KEY_KEY_FILEPATH or APP_STORE_CONNECT_API_KEY_KEY_CONTENT also work.") if api_key.nil?

  api_key
end

platform :ios do
  desc "Run MinitiMobileTests unit tests on iOS Simulator"
  lane :test do
    run_tests(
      project: PROJECT_PATH,
      scheme: IOS_SCHEME,
      destination: ios_unit_test_destination,
      derived_data_path: IOS_DERIVED_DATA_PATH,
      only_testing: ["MinitiMobileTests"],
      code_coverage: true,
      clean: false
    )
  end

  desc "Build the current iOS release archive locally"
  lane :build do
    build_ios_release
  end

  desc "Bump build/version if needed, build, and upload to TestFlight"
  lane :beta do |options|
    prepare_ios_release(options)
    api_key = load_app_store_connect_api_key
    ipa_path = build_ios_release

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      changelog: options[:changelog],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata only (no screenshots, no binary)."
  lane :metadata do |options|
    api_key = load_app_store_connect_api_key

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      metadata_path: File.join(REPO_ROOT, "fastlane", "metadata"),
      skip_metadata: options[:skip_metadata] == true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "Upload screenshots only (no metadata, no binary). Reads from fastlane/screenshots."
  lane :screenshots do |options|
    api_key = load_app_store_connect_api_key
    target_version = options[:version] || options[:app_version]

    upload_to_app_store(
      api_key: api_key,
      app_version: target_version.to_s.empty? ? nil : target_version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      screenshots_path: File.join(REPO_ROOT, "fastlane", "screenshots"),
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "List the App Store screenshot sets on the editable version; pass prune:true to delete sets for display types the repo no longer ships"
  lane :screenshot_sets do |options|
    api_key = load_app_store_connect_api_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key.slice(:key_id, :issuer_id, :key, :duration, :in_house))
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = app.get_edit_app_store_version || app.get_live_app_store_version
    UI.user_error!("No App Store version found") if version.nil?
    require "deliver"
    keep = Dir.glob(File.join(REPO_ROOT, "fastlane", "screenshots", "*", "*.png")).map do |path|
      Deliver::AppScreenshot.new(path, "en-US").display_type
    end.compact.uniq
    UI.message("Version #{version.version_string}; local display types: #{keep.inspect}")
    version.get_app_store_version_localizations.each do |loc|
      loc.get_app_screenshot_sets.each do |set|
        count = set.app_screenshots.to_a.count
        stale = !keep.include?(set.screenshot_display_type)
        UI.message("#{loc.locale} #{set.screenshot_display_type}: #{count} screenshot(s)#{stale ? ' (not in repo)' : ''}")
        next unless stale && options[:prune]
        set.delete!
        UI.important("deleted #{loc.locale} #{set.screenshot_display_type}")
      end
    end
  end

  desc "Bump build/version if needed, build, and upload to App Store Connect with metadata/screenshots without auto-submitting"
  lane :release do |options|
    prepare_ios_release(options)
    api_key = load_app_store_connect_api_key
    ipa_path = build_ios_release
    target_version = options[:version] || options[:app_version]
    app_review_information = ios_app_review_information_from_metadata

    upload_options = {
      api_key: api_key,
      ipa: ipa_path,
      metadata_path: File.join(REPO_ROOT, "fastlane", "metadata"),
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: true,
      force: true
    }
    upload_options[:app_version] = target_version unless target_version.to_s.empty?
    upload_options[:app_review_information] = app_review_information unless app_review_information.nil?

    upload_to_app_store(**upload_options)
  end

  desc "Pull the pending App Review submission so a newer build can replace it"
  lane :cancel_review do
    api_key = load_app_store_connect_api_key
    token = Spaceship::ConnectAPI::Token.create(**api_key.slice(:key_id, :issuer_id, :key, :key_content, :is_key_content_base64).compact)
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find("com.miniti.mobile")
    submissions = app.get_review_submissions(
      filter: { state: "WAITING_FOR_REVIEW,IN_REVIEW,UNRESOLVED_ISSUES,READY_FOR_REVIEW" }
    )
    UI.message("Found #{submissions.count} open review submission(s)")
    submissions.each do |sub|
      UI.message("Cancelling submission #{sub.id} (state=#{sub.state})")
      sub.cancel_submission
    end
    UI.success("No submission is pending") if submissions.empty?
  end

  desc "Attach an uploaded build and submit it for App Review with automatic release"
  lane :submit do |options|
    api_key = load_app_store_connect_api_key
    target_version = options[:version] || options[:app_version]
    build_number = options[:build] || options[:build_number]
    UI.user_error!("Pass version:X.Y.Z") if target_version.to_s.empty?
    UI.user_error!("Pass build:N") if build_number.to_s.empty?

    upload_to_app_store(
      api_key: api_key,
      app_version: target_version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: true,
      automatic_release: true,
      force: true
    )
  end

  private_lane :prepare_ios_release do |options|
    version = options[:version] || options[:version_number]
    build_number = options[:build] || options[:build_number]

    if version
      increment_version_number(
        xcodeproj: PROJECT_PATH,
        version_number: version
      )
    end

    if build_number
      increment_build_number(
        xcodeproj: PROJECT_PATH,
        build_number: build_number
      )
    else
      increment_build_number(xcodeproj: PROJECT_PATH)
    end
  end

  private_lane :build_ios_release do
    build_app(
      project: PROJECT_PATH,
      scheme: IOS_SCHEME,
      configuration: IOS_CONFIGURATION,
      clean: true,
      derived_data_path: IOS_DERIVED_DATA_PATH,
      xcargs: "-allowProvisioningUpdates",
      export_method: "app-store",
      output_directory: IOS_OUTPUT_DIRECTORY,
      output_name: IOS_OUTPUT_NAME
    )
  end

end

platform :mac do
  desc "Run MinitiTests unit tests"
  lane :test do
    run_tests(
      project: PROJECT_PATH,
      scheme: MAC_SCHEME,
      destination: "platform=macOS",
      derived_data_path: MAC_DERIVED_DATA_PATH,
      only_testing: ["MinitiTests"],
      code_coverage: true,
      clean: false
    )
  end

  desc "Build the current macOS Developer ID export locally"
  lane :build do
    build_mac_release
  end

  desc "Notarize the exported macOS app in build/macos/miniti.app"
  lane :notarize_app do |options|
    api_key = load_app_store_connect_api_key
    app_path = options[:app] || mac_app_path

    UI.user_error!("Couldn't find macOS app at #{app_path}. Run `fastlane mac build` first or pass app:/path/to/miniti.app.") unless File.exist?(app_path)
    resign_sparkle_framework(app: app_path, identity: mac_codesign_identity)
    verify_mac_signing_for_notarization(app: app_path)

    notarize(
      package: app_path,
      api_key: api_key,
      print_log: true
    )

    publish_notarized_app_to_root(app: app_path)
  end

  desc "Build, notarize, staple, and Sparkle-sign a DMG from a notarized macOS app"
  lane :dmg do |options|
    app_path = options[:app] || mac_app_path

    UI.user_error!("Couldn't find macOS app at #{app_path}. Run `fastlane mac build` first or pass app:/path/to/miniti.app.") unless File.exist?(app_path)

    api_key = load_app_store_connect_api_key
    dmg_path = build_mac_dmg(app: app_path)
    sign_mac_dmg_for_notarization(dmg: dmg_path, identity: mac_codesign_identity)
    notarize_mac_dmg(dmg: dmg_path, api_key: api_key)
    sign_mac_dmg_for_sparkle(dmg: dmg_path)
  end

  desc "Build and notarize the macOS app, then package, notarize, and Sparkle-sign miniti.dmg"
  lane :release do
    api_key = load_app_store_connect_api_key
    codesign_identity = mac_codesign_identity
    app_path = build_mac_release(identity: codesign_identity)
    resign_sparkle_framework(app: app_path, identity: codesign_identity)
    verify_mac_signing_for_notarization(app: app_path)

    notarize(
      package: app_path,
      api_key: api_key,
      print_log: true
    )

    publish_notarized_app_to_root(app: app_path)
    dmg_path = build_mac_dmg(app: app_path)
    sign_mac_dmg_for_notarization(dmg: dmg_path, identity: codesign_identity)
    notarize_mac_dmg(dmg: dmg_path, api_key: api_key)
    sign_mac_dmg_for_sparkle(dmg: dmg_path)
  end

  private_lane :build_mac_dmg do |options|
    app_path = options[:app]
    sh("#{Shellwords.escape(DMG_SCRIPT_PATH)} #{Shellwords.escape(app_path)}")
    UI.user_error!("DMG packaging completed without producing #{MAC_DMG_PATH}.") unless File.exist?(MAC_DMG_PATH)

    MAC_DMG_PATH
  end

  private_lane :sign_mac_dmg_for_notarization do |options|
    dmg_path = options[:dmg]
    identity = options[:identity]
    UI.user_error!("Couldn't find DMG at #{dmg_path}.") unless File.exist?(dmg_path)

    sh(
      "codesign --force --timestamp " \
      "--sign #{Shellwords.escape(identity)} #{Shellwords.escape(dmg_path)}"
    )
    sh("codesign --verify --verbose=2 #{Shellwords.escape(dmg_path)}")
    UI.success("DMG signed with Developer ID for notarization.")
  end

  private_lane :notarize_mac_dmg do |options|
    dmg_path = options[:dmg]
    UI.user_error!("Couldn't find DMG at #{dmg_path}.") unless File.exist?(dmg_path)

    notarize(
      package: dmg_path,
      api_key: options[:api_key],
      print_log: true
    )

    sh("xcrun stapler validate #{Shellwords.escape(dmg_path)}")
    sh("spctl --assess --type open --context context:primary-signature #{Shellwords.escape(dmg_path)}")
    UI.success("DMG notarization and stapling verified.")
  end

  private_lane :sign_mac_dmg_for_sparkle do |options|
    dmg_path = options[:dmg]
    UI.user_error!("Couldn't find DMG at #{dmg_path}.") unless File.exist?(dmg_path)

    sign_update_path = ENV.fetch("PATH", "")
      .split(File::PATH_SEPARATOR)
      .map { |directory| File.join(directory, "sign_update") }
      .find { |candidate| File.file?(candidate) && File.executable?(candidate) }

    UI.user_error!("Sparkle's sign_update is not on PATH. A Sparkle signature is required before this DMG can ship.") if sign_update_path.nil?

    output, status = Open3.capture2e(sign_update_path, dmg_path)
    unless status.success? && output.include?("sparkle:edSignature=")
      UI.user_error!("sign_update did not produce a valid Sparkle signature.\n#{output}")
    end

    UI.message("Sparkle signature for final stapled DMG:")
    UI.message(output.strip)
  end

  private_lane :build_mac_release do |options|
    codesign_identity = options[:identity] || mac_codesign_identity

    build_mac_app(
      project: PROJECT_PATH,
      scheme: MAC_SCHEME,
      configuration: MAC_CONFIGURATION,
      clean: true,
      derived_data_path: MAC_DERIVED_DATA_PATH,
      archive_path: MAC_ARCHIVE_PATH,
      export_method: "developer-id",
      codesigning_identity: codesign_identity,
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{APPLE_TEAM_ID}",
      export_options: {
        method: "developer-id",
        teamID: APPLE_TEAM_ID,
        signingStyle: "manual",
        signingCertificate: "Developer ID Application"
      },
      skip_package_pkg: true,
      output_directory: MAC_OUTPUT_DIRECTORY,
      output_name: MAC_OUTPUT_NAME
    )
  end

  private_lane :mac_app_path do
    File.join(MAC_OUTPUT_DIRECTORY, "#{MAC_OUTPUT_NAME}.app")
  end

  # Xcode's archive step signs the outer app bundle with Developer ID but does
  # NOT re-sign the nested binaries inside Sparkle.framework (Updater.app,
  # Autoupdate, Downloader.xpc, Installer.xpc). Apple's notarytool rejects them
  # as "not signed with a valid Developer ID certificate" and missing timestamp.
  # Fix: walk the framework deepest-first and re-sign each nested bundle with
  # Developer ID + hardened runtime + secure timestamp, then re-seal the app.
  private_lane :resign_sparkle_framework do |options|
    app_path = options[:app]
    identity = options[:identity]
    UI.user_error!("resign_sparkle_framework requires :app and :identity") if app_path.to_s.empty? || identity.to_s.empty?

    sparkle_path = File.join(app_path, "Contents/Frameworks/Sparkle.framework")
    unless File.exist?(sparkle_path)
      UI.message("No Sparkle.framework at #{sparkle_path}; skipping Sparkle re-sign.")
      next
    end

    UI.message("Re-signing Sparkle.framework nested binaries with Developer ID + hardened runtime…")

    versions_dir = File.join(sparkle_path, "Versions")
    active_version = Dir.glob(File.join(versions_dir, "*")).map { |p| File.basename(p) }.find { |name| name != "Current" } || "B"
    version_root = File.join(versions_dir, active_version)

    # Deepest-first so outer containers have valid inner signatures sealed inside.
    # Sparkle's own nested binaries have no entitlements of their own, so re-signing
    # without --entitlements is correct for them.
    nested_targets = [
      File.join(version_root, "XPCServices/Downloader.xpc"),
      File.join(version_root, "XPCServices/Installer.xpc"),
      File.join(version_root, "Autoupdate"),
      File.join(version_root, "Updater.app"),
      sparkle_path
    ]

    nested_targets.each do |target|
      next unless File.exist?(target)
      sh(
        "codesign --force --options=runtime --timestamp " \
        "--sign #{Shellwords.escape(identity)} #{Shellwords.escape(target)}",
        log: false
      )
    end

    # The outer app must be re-signed AFTER nested contents change (otherwise
    # the outer code-signature hash is invalid), but it needs its entitlements
    # preserved. Pass --entitlements explicitly — without this flag, codesign
    # --force silently strips them, which disables sandbox at runtime and moves
    # the app's SwiftData store to a different path (new empty container),
    # making "my history is wiped" the user-visible symptom.
    entitlements_path = File.join(REPO_ROOT, "Miniti", "Miniti.entitlements")
    UI.user_error!("Entitlements file missing at #{entitlements_path}") unless File.exist?(entitlements_path)
    sh(
      "codesign --force --options=runtime --timestamp " \
      "--entitlements #{Shellwords.escape(entitlements_path)} " \
      "--sign #{Shellwords.escape(identity)} #{Shellwords.escape(app_path)}",
      log: false
    )

    UI.success("Sparkle re-sign complete (outer app entitlements preserved).")
  end

  private_lane :verify_mac_signing_for_notarization do |options|
    app_path = options[:app]
    output, status = Open3.capture2e("codesign", "-dv", "--verbose=4", app_path)
    UI.user_error!("Unable to inspect code signature for #{app_path}.\n#{output}") unless status.success?

    unless output.include?("Authority=Developer ID Application:")
      UI.user_error!("The app at #{app_path} is not signed with a valid Developer ID Application certificate. Run `fastlane mac build` after confirming your Developer ID certificate is available in your login keychain.")
    end

    unless output.match?(/^Timestamp=/)
      UI.user_error!("The app at #{app_path} is signed without a secure timestamp. Rebuild with Developer ID signing and retry notarization.")
    end

    # Confirm entitlements survived signing. A stripped-entitlements build
    # ships without the sandbox — users experience "my history is gone" because
    # SwiftData lands in a different directory (non-sandboxed vs sandboxed).
    ent_output, ent_status = Open3.capture2e("codesign", "-d", "--entitlements", ":-", app_path)
    UI.user_error!("Unable to inspect entitlements for #{app_path}.\n#{ent_output}") unless ent_status.success?

    unless ent_output.include?("com.apple.security.app-sandbox")
      UI.user_error!(<<~MSG)
        The app at #{app_path} is signed WITHOUT the app-sandbox entitlement.
        This would ship a non-sandboxed build that reads from a fresh empty
        SwiftData store (users see "history disappeared"). Ensure the
        resign_sparkle_framework lane passes --entitlements when re-signing
        the outer app, and that Miniti/Miniti.entitlements contains
        com.apple.security.app-sandbox.
      MSG
    end
  end

  private_lane :publish_notarized_app_to_root do |options|
    source_app = options[:app]
    UI.user_error!("Couldn't find notarized app at #{source_app}.") unless File.exist?(source_app)

    FileUtils.rm_rf(MAC_ROOT_APP_PATH)
    FileUtils.cp_r(source_app, MAC_ROOT_APP_PATH)
    UI.message("Notarized app copied to #{MAC_ROOT_APP_PATH}")
  end
end
